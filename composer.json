{
    "name": "tritech/threadwire-laravel",
    "description": "Threadwire for Laravel: send WhatsApp messages through your own linked numbers, with Threadwire's ban protection, and receive its signed webhooks as Laravel events.",
    "type": "library",
    "license": "MIT",
    "keywords": ["threadwire", "whatsapp", "laravel", "webhooks", "standard-webhooks"],
    "homepage": "https://threadwire.tri-tech.net",
    "authors": [
        {
            "name": "TriTech Solutions",
            "email": "hello@tri-tech.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Threadwire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Threadwire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Threadwire\\ThreadwireServiceProvider"
            ],
            "aliases": {
                "Threadwire": "Threadwire\\Facades\\Threadwire"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
