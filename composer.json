{
    "name": "tritech/threadwire-laravel",
    "description": "Official Laravel package for Threadwire: send WhatsApp messages through your own linked numbers with built-in ban protection, verify phone numbers with WhatsApp, and receive signed webhooks as Laravel events.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "threadwire",
        "whatsapp",
        "whatsapp-api",
        "laravel",
        "laravel-package",
        "otp",
        "whatsapp-otp",
        "webhooks",
        "standard-webhooks"
    ],
    "homepage": "https://threadwire.tri-tech.net",
    "support": {
        "issues": "https://github.com/khaledtarek54/threadwire-laravel/issues",
        "source": "https://github.com/khaledtarek54/threadwire-laravel",
        "docs": "https://threadwire.tri-tech.net/docs/api"
    },
    "authors": [
        {
            "name": "TriTech Solutions",
            "email": "hello@tri-tech.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Threadwire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Threadwire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Threadwire\\ThreadwireServiceProvider"
            ],
            "aliases": {
                "Threadwire": "Threadwire\\Facades\\Threadwire"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
